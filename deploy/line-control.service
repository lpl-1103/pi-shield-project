# 主服務：Flask app（LINE Webhook + 網頁面板 + 點歌 API）
#
# 部署位置：/etc/systemd/system/line-control.service
# 啟用：sudo systemctl enable --now line-control.service
#
# Restart=on-failure 是刻意的：systemd 把 SIGTERM 當正常結束、SIGKILL 當失敗。
# 手動 stop 不會被拉起來，真的掛掉才會。

[Unit]
Description=Pi3 Shield LINE Bot + Karaoke System
After=network-online.target
Wants=network-online.target

# ⚠ 換一台機器接手：下面的 lpl1103 是原作者的樹莓派帳號，要整批換成你自己的
#    sed -i '' "s/lpl1103/<你的帳號>/g" deploy/*.service
[Service]
Type=simple
User=lpl1103
WorkingDirectory=/home/lpl1103
ExecStart=/usr/bin/python3 /home/lpl1103/line_control.py
# 沒有這行的話，程式裡的 print() 會被 Python 的 stdout 緩衝卡住，
# journal 裡只看得到 Flask 的存取日誌（那條走 stderr 不受影響），
# 自己印的診斷訊息要等緩衝區滿了才出現——除錯時會誤判成「沒有執行到」。
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
